# Copia este archivo como .env.local y completa los valores.
# .env.local nunca se sube al repositorio.

# --- Supabase ---------------------------------------------------------------

# URL del proyecto. Panel de Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública. Viaja al navegador; es normal que sea visible.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta. PRIVADA: solo servidor.
# Nunca la renombres con el prefijo NEXT_PUBLIC_ ni la importes desde un
# componente de cliente: eso la publicaría en el navegador.
SUPABASE_SECRET_KEY=

# --- Aplicación -------------------------------------------------------------

# URL base para los enlaces de los correos de acceso y recuperación.
# En local: http://localhost:3000. En producción, el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo autorizado para la activación privada. Funciona como allowlist; no
# asigna el rol por sí solo. Debe coincidir con --email en admin:bootstrap.
ADMIN_EMAIL=

# Modo privado: solo la administradora puede entrar.
# Cualquier valor distinto de "false" mantiene la app cerrada, incluso si la
# variable no existe. Ponlo en "false" solo cuando se decida abrir el registro
# de estudiantes, y revisa antes que el alta esté también cerrada en Supabase.
PRIVATE_ACCESS_ONLY=true

# --- Archivo editorial local -----------------------------------------------

# Carpeta privada que contiene AUDIO 01.txt a AUDIO 70.txt. Solo la usan los
# comandos editoriales locales; no se configura en Vercel ni se publica.
# Ejemplo: C:\Users\TU-USUARIO\Documents\CENEVAL-ARCHIVO-EDITORIAL\transcripciones-originales
CENEVAL_TRANSCRIPTS_DIR=
